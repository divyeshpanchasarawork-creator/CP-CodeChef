
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CP: Run with input.txt",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "mkdir -p \"${workspaceFolder}/.build\" && javac -encoding UTF-8 -d \"${workspaceFolder}/.build\" \"${file}\" && java -cp \"${workspaceFolder}/.build\" Main < \"${workspaceFolder}/input.txt\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "CP: Run interactively",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "mkdir -p \"${workspaceFolder}/.build\" && javac -encoding UTF-8 -d \"${workspaceFolder}/.build\" \"${file}\" && java -cp \"${workspaceFolder}/.build\" Main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$javac"],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
